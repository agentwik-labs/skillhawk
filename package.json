{
  "name": "skillhawk",
  "version": "0.4.0",
  "description": "Check your AI agent skills before your agents run them: grade, security-scan and compile SKILL.md files, find agents nobody is watching. CLI and local MCP server.",
  "mcpName": "io.github.agentwik-labs/skillhawk",
  "type": "module",
  "bin": {
    "skillhawk": "bin/skillyard.js",
    "skillyard": "bin/skillyard.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "studio",
    "starter-kit",
    "registry",
    "seed",
    "sources",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/skillyard.js serve",
    "seed": "node bin/skillyard.js seed",
    "dev": "node bin/skillyard.js seed && node bin/skillyard.js serve",
    "test": "node --test test/*.test.js",
    "validate": "node bin/skillyard.js validate registry/public seed/orgs/*/skills",
    "build:marketplace": "node bin/skillyard.js export claude-marketplace --out ."
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentwik-labs/skillhawk.git"
  },
  "homepage": "https://skillhawk.ai/",
  "bugs": {
    "url": "https://github.com/agentwik-labs/skillhawk/issues"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "skills",
    "ai-agents",
    "agents-md",
    "llm",
    "ai-coding-agents",
    "unattended-agents",
    "claude-code-cost",
    "mcp-server",
    "agent-security",
    "skill-md",
    "developer-tools"
  ]
}
